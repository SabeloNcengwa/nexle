# Copy to apps/api/.env and apps/web/.env as needed.
# Never commit real secrets.

NODE_ENV=development
PORT=8080
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
WEB_BASE_URL=http://localhost:5173
ADMIN_BASE_URL=http://localhost:5174

FIREBASE_PROJECT_ID=demo-mavundla
FIREBASE_STORAGE_BUCKET=demo-mavundla.appspot.com

# Supabase (database + Storage). Project: sttgjxiyyyanfvynrqfb
SUPABASE_URL=https://sttgjxiyyyanfvynrqfb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Settings → Database → Connection string (URI). Prefer transaction pooler for serverless.
SUPABASE_DB_URL=

# Leave unset when using Auth emulator
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# Render / hosts without a key file: paste SA JSON (or base64 of that JSON)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Emulator hosts (API) — Auth only; data/uploads use Supabase
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Optional gate for bootstrap script
ADMIN_BOOTSTRAP_SECRET=

# Protects POST /v1/jobs/*
JOBS_SECRET=dev-jobs-secret

# Network security (production money traffic)
# REQUIRE_HTTPS=true          # default on in production; set false only for break-glass
# ALLOWED_HOSTS=              # optional Host header allowlist, e.g. api.nexle.co.za
# WEBHOOK_IP_ALLOWLIST=       # optional Paystack/courier webhook source IPs
# JOBS_IP_ALLOWLIST=          # optional Cloud Scheduler / ops IPs for /v1/jobs/*

# Reservation expiry polling in API process (0 disables)
RESERVATION_EXPIRY_INTERVAL_MS=60000

# Payments: mock | unconfigured | paystack_marketplace | ozow_marketplace
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_DILIGENCE_SIGNED=

# Couriers: mock | unconfigured | the_courier_guy | bob_go
COURIER_PROVIDER=mock
ALLOW_MOCK_COURIER=
COURIER_PROVIDER_API_KEY=
COURIER_DILIGENCE_SIGNED=

# Email: mock | unconfigured | sendgrid | ses | resend
EMAIL_PROVIDER=mock
ALLOW_MOCK_EMAIL=
EMAIL_PROVIDER_API_KEY=
EMAIL_DILIGENCE_SIGNED=

# SMS: mock | unconfigured | twilio | clickatell
SMS_PROVIDER=mock
ALLOW_MOCK_SMS=
SMS_PROVIDER_API_KEY=
SMS_DILIGENCE_SIGNED=

# Controlled pilot / public launch
PILOT_MODE=false
PILOT_SELLER_ALLOWLIST=
MAINTENANCE_MODE=false
PUBLIC_LAUNCH=false

# Web (Vite) — public Firebase Auth + Supabase project URL (anon key optional; uploads use API signed URLs)
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-mavundla
VITE_FIREBASE_STORAGE_BUCKET=demo-mavundla.appspot.com
VITE_FIREBASE_APP_ID=demo-app-id
VITE_SUPABASE_URL=https://sttgjxiyyyanfvynrqfb.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8080
VITE_USE_EMULATORS=true
